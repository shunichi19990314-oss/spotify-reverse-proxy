# ============================================================
# spotify-reverse-proxy 環境変数サンプル
# ローカル : cp .env.example .env してから値を書き換え、
#            set -a; . ./.env; set +a; npm start
# Render   : ダッシュボードの Environment タブ、または render.yaml で設定
# Railway  : ダッシュボードの Variables タブ、または .railway/railway.ts（IaC）で設定
#            CLI なら  railway variables --set "ACCESS_TOKEN=xxxx"
#
# PORT は Render / Railway のどちらも**自動注入**されるので設定しないこと。
# ============================================================

# --- 基本 ---
PORT=10000
HOST=0.0.0.0
LOG_LEVEL=info                 # error | warn | info | debug
DEBUG_HEADERS=false            # true で x-spx-upstream ヘッダを付ける

# --- プロキシ先 ---
DEFAULT_UPSTREAM_HOST=open.spotify.com
UPSTREAM_SCHEME=https          # ローカル検証以外では https 固定でよい
HOST_PREFIX=/__h/
WS_PREFIX=/__w/
UPSTREAM_TIMEOUT_MS=30000
MAX_REWRITE_BYTES=67108864     # 64MB。これを超えるテキストは書き換えず素通し

# 中継を許可する登録可能ドメイン（カンマ区切り）。既定値で Spotify 一式をカバーする。
# PROXY_ALLOW_DOMAINS=spotify.com,scdn.co,pscdn.co,spotifycdn.com,spotify.net,spotilocal.com,spotify.map.fastly.net,akamaized.net,akamaihd.net,cloudfront.net

# --- キャッシュ ---
CACHE_MAX_BYTES=67108864       # 64MB。0 で無効化
CACHE_MAX_ENTRIES=300
CACHE_MAX_TTL_SEC=3600

# --- 書き換えに埋め込む自オリジン ---
# 空なら Host / x-forwarded-host / x-forwarded-proto から自動判定する。
# 前面に別のプロキシがあって Host が実公開ドメインにならない場合のみ設定する。
# PUBLIC_BASE_URL=https://example.com

# --- セキュリティ ---
# 空にすると誰でも使える完全公開プロキシになる。公開 URL では必ず設定すること。
ACCESS_TOKEN=
# 認証方法: ?token=XXX / Authorization: Bearer XXX / Cookie spx_token=XXX

# --- 埋め込み / CORS ---
ALLOW_EMBED=true               # false で iframe 埋め込みを禁止（SameSite=Lax になる）
FRAME_ANCESTORS=*              # 例: https://example.com https://*.example.com
CORS_ORIGINS=                  # 例: https://example.com,* （空なら CORS ヘッダを付けない）

# --- 上流へ送るヘッダ ---
USER_AGENT=                    # 空なら利用者のブラウザ UA をそのまま転送
ACCEPT_LANGUAGE=ja,en-US;q=0.9,en;q=0.8

# ============================================================
# PaaS が自動で注入する変数（設定不要・参考）
# ============================================================
# Render : PORT, RENDER_EXTERNAL_URL, RENDER_SERVICE_ID, RENDER_REGION
# Railway: PORT, RAILWAY_PUBLIC_DOMAIN, RAILWAY_PRIVATE_DOMAIN,
#          RAILWAY_ENVIRONMENT, RAILWAY_PROJECT_ID, RAILWAY_SERVICE_ID
#
# 起動時に RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL があれば
# アクセス先 URL をログに出力します。
